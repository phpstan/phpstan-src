parameters:
	title: PHPStan
	themeDir: theme

services:
	analyzer.filter:
		factory: PHPStan\ApiGen\Filter(excludeProtected: %excludeProtected%, excludePrivate: %excludePrivate%, excludeTagged: %excludeTagged%)

	renderer.filter:
		factory: PHPStan\ApiGen\RendererFilter

	analyze.phpDocResolver:
		factory: PHPStan\ApiGen\PhpDocResolver

	commonMark:
		factory: PHPStan\ApiGen\MarkdownConverter

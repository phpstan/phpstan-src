{
	"name": "phpstan/phpstan-src",
	"description": "PHPStan - PHP Static Analysis Tool",
	"license": [
		"MIT"
	],
	"authors": [
		{
			"name": "Ondřej Mirtes"
		},
		{
			"name": "Markus Staab"
		},
		{
			"name": "Vincent Langlet"
		}
	],
	"require": {
		"php": "^8.2",
		"composer-runtime-api": "^2.0",
		"clue/ndjson-react": "^1.0",
		"composer/semver": "^3.4",
		"composer/xdebug-handler": "^3.0.3",
		"fidry/cpu-core-counter": "^1.2",
		"guzzlehttp/guzzle": "^7.9",
		"hoa/compiler": "3.17.08.08",
		"hoa/exception": "^1.0",
		"hoa/file": "1.17.07.11",
		"jetbrains/phpstorm-stubs": "dev-master#2da66a03e379335dba086b0d493c70185eb01ddd",
		"nette/bootstrap": "^3.0",
		"nette/di": "^3.1.10",
		"nette/neon": "3.3.4",
		"nette/php-generator": "3.6.9",
		"nette/schema": "^1.2.2",
		"nette/utils": "^3.2.5",
		"nikic/php-parser": "^5.8.0",
		"ondram/ci-detector": "^4.0",
		"ondrejmirtes/better-reflection": "dev-feat/versioned-extension-stubs as 6.70.0.4",
		"ondrejmirtes/composer-attribute-collector": "^1.2.0",
		"ondrejmirtes/php-merge": "^4.1",
		"phpstan/php-8-stubs": "0.4.35",
		"phpstan/phpdoc-parser": "2.3.3",
		"react/child-process": "^0.7",
		"react/event-loop": "^1.2",
		"react/promise": "^3.2",
		"react/socket": "^1.3",
		"react/stream": "^1.1",
		"sebastian/diff": "^6.0.2 || ^7",
		"symfony/console": "^5.4.3",
		"symfony/finder": "^5.4.3",
		"symfony/polyfill-intl-grapheme": "^1.23",
		"symfony/polyfill-intl-normalizer": "^1.23",
		"symfony/polyfill-mbstring": "^1.23",
		"symfony/polyfill-php80": "^1.23",
		"symfony/polyfill-php81": "^1.27",
		"symfony/polyfill-php83": "^1.33",
		"symfony/polyfill-php84": "^1.33",
		"symfony/polyfill-php85": "^1.33",
		"symfony/process": "^5.4.3",
		"symfony/service-contracts": "^2.5.0",
		"symfony/string": "^5.4.3"
	},
	"replace": {
		"phpstan/phpstan": "2.2.x",
		"symfony/polyfill-php73": "*"
	},
	"suggest": {
		"ext-pcntl": "Enables forking parallel analysis workers from the already-booted process (experimental, skips the per-worker re-boot)",
		"ext-posix": "Used together with ext-pcntl for forked parallel analysis workers"
	},
	"require-dev": {
		"cweagans/composer-patches": "^1.7.3",
		"php-parallel-lint/php-parallel-lint": "^1.2.0",
		"phpstan/phpstan-deprecation-rules": "^2.0.2",
		"phpstan/phpstan-nette": "^2.0",
		"phpstan/phpstan-phpunit": "^2.0.19",
		"phpstan/phpstan-strict-rules": "^2.0",
		"phpunit/phpunit": "^11.5.23",
		"shipmonk/composer-dependency-analyser": "^1.5",
		"shipmonk/dead-code-detector": "^1.0.0",
		"shipmonk/name-collision-detector": "^2.0"
	},
	"repositories": [
		{
			"type": "vcs",
			"url": "https://github.com/simPod/BetterReflection"
		}
	],
	"config": {
		"platform": {
			"php": "8.2.99"
		},
		"platform-check": false,
		"sort-packages": true,
		"allow-plugins": {
			"cweagans/composer-patches": true,
			"ondrejmirtes/composer-attribute-collector": true,
			"vaimo/composer-patches": true
		}
	},
	"extra": {
		"composer-attribute-collector": {
			"include": [
				"src"
			]
		},
		"composer-exit-on-patch-failure": true,
		"patches": {
			"composer/ca-bundle": [
				"patches/cloudflare-ca.patch"
			],
			"hoa/exception": [
				"patches/Idle.patch"
			],
			"hoa/file": [
				"patches/File.patch",
				"patches/Read.patch"
			],
			"hoa/iterator": [
				"patches/Buffer.patch",
				"patches/Lookahead.patch"
			],
			"hoa/compiler": [
				"patches/HoaException.patch",
				"patches/HoaParser.patch",
				"patches/Invocation.patch",
				"patches/Rule.patch",
				"patches/Lexer.patch",
				"patches/TreeNode.patch"
			],
			"hoa/consistency": [
				"patches/Consistency.patch"
			],
			"hoa/protocol": [
				"patches/Node.patch",
				"patches/Wrapper.patch"
			],
			"hoa/stream": [
				"patches/Stream.patch"
			],
			"jetbrains/phpstorm-stubs": [
				"patches/ReflectionProperty.patch",
				"patches/SessionHandler.patch",
				"patches/xmlreader.patch",
				"patches/dom_c.patch"
			],
			"nette/di": [
				"patches/Resolver.patch"
			],
			"symfony/console": [
				"patches/OutputFormatter.patch",
				"patches/Application.patch"
			]
		}
	},
	"autoload": {
		"psr-4": {
			"PHPStan\\": [
				"src/"
			]
		},
		"files": ["src/debugScope.php", "src/dumpType.php", "src/autoloadFunctions.php", "src/Testing/functions.php"]
	},
	"autoload-dev": {
		"psr-4": {
			"PHPStan\\": [
				"build/PHPStan"
			]
		},
		"classmap": [
			"tests/e2e",
			"tests/PHPStan",
			"tests/bench"
		]
	},
	"scripts": {
		"post-autoload-dump": "@php -r \"if (is_file('build/generate-turbo-stubs.php')) include 'build/generate-turbo-stubs.php';\""
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"bin": [
		"bin/phpstan"
	]
}

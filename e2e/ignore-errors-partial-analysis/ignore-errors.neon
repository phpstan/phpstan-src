parameters:
	ignoreErrors:
		# matched whenever src/Plain/Foo.php is analysed, but fewer times than expected
		-
			identifier: return.type
			path: src/Plain/Foo.php
			count: 2
		-
			identifier: return.type
			path: srcc/Bar.php
		-
			message: '#never in Clean#'
			path: src/Plain/Clean.php
		-
			message: '#never in srcc#'
			path: srcc/Bar.php
		-
			message: '#never in Plain directory#'
			path: src/Plain
		-
			message: '#never in srcc directory#'
			path: srcc
		-
			message: '#never in Plain glob#'
			path: src/Plain/*.php
		-
			message: '#never in src glob#'
			path: src/*/Clean.php
		-
			message: '#never in leading glob#'
			path: '*/Plain/Clean.php'
		-
			message: '#never in two paths#'
			paths:
				- src/Plain/Clean.php
				- srcc/Bar.php
		- '#never globally#'
		-
			message: '#never globally either#'

		# SharedTrait's error is reported in the files of the classes using it
		-
			identifier: return.type
			path: src/Classes/UsesSharedTrait.php
		-
			identifier: return.type
			path: tests/TestUsesSharedTrait.php
		# InnerTrait's error is reported in the file of the class using OuterTrait
		-
			identifier: return.type
			path: src/Classes/UsesNestedTrait.php
		-
			message: '#never in SharedTrait#'
			path: src/Traits/SharedTrait.php
		-
			message: '#never in Classes directory#'
			path: src/Classes
		# LibTrait is not in the analysed paths even when the whole project is analysed
		-
			message: '#never in UsesLibTrait#'
			path: src/Classes/UsesLibTrait.php
		# one error is the class's own, the other one is SharedTrait's
		-
			identifier: return.type
			path: src/Classes/UsesSharedTraitWithOwnError.php
			count: 2
		-
			identifier: return.type
			path: src/Classes/EnumUsesSharedTrait.php
		-
			identifier: return.type
			path: src/Classes/AnonymousUsesSharedTrait.php
		-
			message: '#never in ChildOfTraitUser#'
			path: src/Inherit/ChildOfTraitUser.php
		# ExcludedTrait is excluded from the analysis even when the whole project is analysed
		-
			message: '#never in UsesExcludedTrait#'
			path: src/Classes/UsesExcludedTrait.php
		-
			message: '#never in ClassAndTrait#'
			path: src/Mixed/ClassAndTrait.php
		-
			identifier: trait.unused
			path: src/Mixed/ClassAndTrait.php
		# reported only when the declaration of the called function is analysed too
		-
			identifier: function.resultUnused
			path: src/Calls/CallsPureFunction.php
		# reported only when the declarations of the called function and of the function it calls are analysed too
		-
			identifier: function.resultUnused
			path: src/Calls/CallsTransitivelyPureFunction.php
		# reported only when the subclass renaming the parameter is analysed too
		-
			identifier: argument.parameterRenamedInSubtype
			path: src/Named/CallsWithNamedArgument.php
		# stale, reported only when what is reported in the file is known
		-
			message: '#never in CallsPureFunction#'
			path: src/Calls/CallsPureFunction.php
		-
			message: '#never in CallsTransitivelyPureFunction#'
			path: src/Calls/CallsTransitivelyPureFunction.php
		-
			message: '#never in CallsWithNamedArgument#'
			path: src/Named/CallsWithNamedArgument.php

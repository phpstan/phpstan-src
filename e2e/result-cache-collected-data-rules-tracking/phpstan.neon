includes:
	- ../../conf/bleedingEdge.neon

parameters:
	level: 8
	tmpDir: tmp
	paths:
		- src
	scanDirectories:
		- lib

services:
	-
		class: ResultCacheCollectedDataRulesTracking\ViewCollector
		tags:
			- phpstan.collector
	-
		class: ResultCacheCollectedDataRulesTracking\ViewRule
		arguments:
			viewsDirectory: %currentWorkingDirectory%/views
			ignoredViewsFile: %currentWorkingDirectory%/ignored-views.txt
		tags:
			- phpstan.rules.rule
	-
		class: ResultCacheCollectedDataRulesTracking\MoreViewsExtension
		arguments:
			moreViewsFile: %currentWorkingDirectory%/more-views.txt
		tags:
			- phpstan.broker.methodsClassReflectionExtension

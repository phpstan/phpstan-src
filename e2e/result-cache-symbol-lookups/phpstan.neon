includes:
	- ../../conf/bleedingEdge.neon

parameters:
	level: 8
	tmpDir: tmp
	paths:
		- src
	scanDirectories:
		- scanned

rules:
	- ResultCacheE2ESymbolLookupsRules\ReplacementRule
	- ResultCacheE2ESymbolLookupsRules\CollectedReplacementRule

services:
	-
		class: ResultCacheE2ESymbolLookupsRules\LegacyCallCollector
		tags:
			- phpstan.collector

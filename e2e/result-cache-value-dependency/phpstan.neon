parameters:
	level: 8
	tmpDir: tmp
	paths:
		- src
	inferPrivatePropertyTypeFromConstructor: true

	# ValueDependencyCollector keeps class declarations per process, so Magic.php only gets
	# the magic method dependency when it shares a process with a file that asked the extension
	parallel:
		maximumNumberOfProcesses: 1

services:
	-
		class: ResultCacheE2EValueDependency\HasServiceValueExtension
		tags:
			- phpstan.resultCacheValueExtension
	-
		class: ResultCacheE2EValueDependency\ParameterValueExtension
		tags:
			- phpstan.resultCacheValueExtension
	-
		class: ResultCacheE2EValueDependency\ServiceRule
		tags:
			- phpstan.rules.rule
	-
		class: ResultCacheE2EValueDependency\ServiceReturnTypeExtension
		tags:
			- phpstan.broker.dynamicFunctionReturnTypeExtension
	-
		class: ResultCacheE2EValueDependency\ParameterReturnTypeExtension
		tags:
			- phpstan.broker.dynamicFunctionReturnTypeExtension
	-
		class: ResultCacheE2EValueDependency\MayThrowThrowTypeExtension
		tags:
			- phpstan.dynamicFunctionThrowTypeExtension
	-
		class: ResultCacheE2EValueDependency\RegionCollector
		tags:
			- phpstan.collector
	-
		class: ResultCacheE2EValueDependency\RegionRule
		tags:
			- phpstan.rules.rule
	-
		class: ResultCacheE2EValueDependency\WithThisClosureThisExtension
		tags:
			- phpstan.functionParameterClosureThisExtension
	-
		class: ResultCacheE2EValueDependency\IsAllowedTypeSpecifyingExtension
		tags:
			- phpstan.typeSpecifier.functionTypeSpecifyingExtension
	-
		class: ResultCacheE2EValueDependency\ViewRule
		tags:
			- phpstan.rules.rule
	-
		class: ResultCacheE2EValueDependency\MakeReturnTypeExtension
		tags:
			- phpstan.broker.dynamicFunctionReturnTypeExtension
	-
		class: ResultCacheE2EValueDependency\MagicMethodsExtension
		tags:
			- phpstan.broker.methodsClassReflectionExtension

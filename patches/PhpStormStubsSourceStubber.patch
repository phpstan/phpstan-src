+     */
+    private function addTagToDocComment($node, string $tag): void
+    {
+        $docComment = $node->getDocComment();
+
+        if ($docComment === null) {
+            $docCommentText = sprintf('/** @%s */', $tag);
+        } else {
+            $docCommentText = preg_replace_callback(
+                '~(\r?\n\s*)\*/~',
+                static fn (array $matches): string => sprintf('%s* @%s%s*/', $matches[1], $tag, $matches[1]),
+                $docComment->getText()
+            );
+            assert($docCommentText !== null);
+        }
+
+        $node->setDocComment(new Doc($docCommentText));
+    }

<?php

class ReflectionMethod
{

	/**
	 * @var class-string
	 */
	public $class;

	/**
	 * @var non-falsy-string
	 */
	public $name;

	/**
	 * @throws \Throwable
	 */
	public function invoke(?object $object, mixed ...$args): mixed {}

	/**
	 * @throws \Throwable
	 */
	public function invokeArgs(?object $object, array $args): mixed {}

}

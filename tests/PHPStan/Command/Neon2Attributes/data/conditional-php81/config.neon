services:
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\ConditionalRule
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\NegatedRule
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\ListRule
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\ConditionalExtension
		arguments:
			flag: %checkUninitializedProperties%
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\TaggedAndConditional
		tags:
			- phpstan.rules.rule
	-
		class: Neon2AttributesFixtures\ConditionalPhp81\DifferentConditions

rules:
	- Neon2AttributesFixtures\ConditionalPhp81\RuleSectionConditional

conditionalTags:
	Neon2AttributesFixtures\ConditionalPhp81\ConditionalRule:
		phpstan.rules.rule: %featureToggles.bleedingEdge%
	Neon2AttributesFixtures\ConditionalPhp81\NegatedRule:
		phpstan.rules.rule: not(%featureToggles.bleedingEdge%)
	Neon2AttributesFixtures\ConditionalPhp81\ListRule:
		phpstan.rules.rule: [%featureToggles.bleedingEdge%, not(%checkUninitializedProperties%)]
	Neon2AttributesFixtures\ConditionalPhp81\ConditionalExtension:
		phpstan.properties.readWriteExtension: %featureToggles.bleedingEdge%
	Neon2AttributesFixtures\ConditionalPhp81\TaggedAndConditional:
		phpstan.collector: %featureToggles.bleedingEdge%
	Neon2AttributesFixtures\ConditionalPhp81\DifferentConditions:
		phpstan.rules.rule: %featureToggles.bleedingEdge%
		phpstan.collector: %checkUninitializedProperties%
	Neon2AttributesFixtures\ConditionalPhp81\RuleSectionConditional:
		phpstan.rules.rule: %featureToggles.bleedingEdge%
	Neon2AttributesFixtures\ConditionalPhp81\RegisteredElsewhere:
		phpstan.rules.rule: %featureToggles.bleedingEdge%

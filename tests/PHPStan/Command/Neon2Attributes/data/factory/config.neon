services:
	-
		class: Neon2AttributesFixtures\Factory\Created
		factory: @Neon2AttributesFixtures\Factory\CreatedFactory::create
	-
		class: Neon2AttributesFixtures\Factory\CreatedFactory
	-
		class: Neon2AttributesFixtures\Factory\StaticallyCreated
		factory: Neon2AttributesFixtures\Factory\CreatedFactory::createStatically()
	-
		class: Neon2AttributesFixtures\Factory\ArrayCreated
		factory: [@Neon2AttributesFixtures\Factory\CreatedFactory, createArray]
	-
		class: Neon2AttributesFixtures\Factory\ParameterCreated
		factory: @%factoryService%::create
	-
		class: Neon2AttributesFixtures\Factory\Aliased
		factory: @Neon2AttributesFixtures\Factory\CreatedFactory
	-
		class: Neon2AttributesFixtures\Factory\CreatedInterface
		factory: Neon2AttributesFixtures\Factory\Implementation
	-
		type: Neon2AttributesFixtures\Factory\TypedInterface
		factory: [@Neon2AttributesFixtures\Factory\CreatedFactory, createTyped]
	-
		class: Neon2AttributesFixtures\Factory\SameClass
		factory: \Neon2AttributesFixtures\Factory\SameClass
	-
		class: Neon2AttributesFixtures\Factory\SameClassWithArguments
		factory: \Neon2AttributesFixtures\Factory\SameClassWithArguments(%tmpDir%)
	-
		class: Neon2AttributesFixtures\Factory\StaticWithArguments
		factory: Neon2AttributesFixtures\Factory\StaticWithArguments::create(%tmpDir%)

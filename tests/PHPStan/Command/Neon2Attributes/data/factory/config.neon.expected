services:
	-
		class: Neon2AttributesFixtures\Factory\ParameterCreated
		factory: @%factoryService%::create
	-
		class: Neon2AttributesFixtures\Factory\Aliased
		factory: @Neon2AttributesFixtures\Factory\CreatedFactory
	-
		class: Neon2AttributesFixtures\Factory\StaticWithArguments
		factory: Neon2AttributesFixtures\Factory\StaticWithArguments::create(%tmpDir%)

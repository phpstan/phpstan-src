services:
	-
		class: Neon2AttributesFixtures\Tags\TaggedExtension
		tags:
			- phpstan.properties.readWriteExtension
	-
		class: Neon2AttributesFixtures\Tags\UntaggedExtension
	-
		class: Neon2AttributesFixtures\Tags\TaggedRule
		tags: [phpstan.rules.rule]
	-
		class: Neon2AttributesFixtures\Tags\PartiallyTaggedExtension
		tags:
			- phpstan.properties.readWriteExtension
	-
		class: Neon2AttributesFixtures\Tags\UnknownTag
		tags:
			- my.own.tag

<?php declare(strict_types = 1);

namespace TypeTraverserMapMemoizedRule;

use PHPStan\Type\Generic\TemplateType;
use PHPStan\Type\IntegerType;
use PHPStan\Type\Type;
use PHPStan\Type\TypeTraverser;
use function array_merge;
use function spl_object_id;

class Foo
{

	/** @var list<Type> */
	private array $types = [];

	public function pure(Type $type): Type
	{
		return TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse): Type {
			if ($type instanceof TemplateType) {
				return $type->getBound();
			}

			return $traverse($type);
		});
	}

	public function arrowFunction(Type $type): Type
	{
		return TypeTraverser::mapMemoized($type, static fn (Type $type, callable $traverse): Type => $traverse($type));
	}

	public function flagAndKeyedWrite(Type $type): Type
	{
		$found = false;
		$names = [];
		$result = TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse) use (&$found, &$names): Type {
			if ($type instanceof TemplateType) {
				$found = true;
				$names[$type->getName()] = true;
				unset($names['foo']);
			}

			return $traverse($type);
		});

		return $result;
	}

	public function flagReadWithUnusedResult(Type $type): bool
	{
		$found = false;
		TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse) use (&$found): Type {
			if ($type instanceof TemplateType) {
				$found = true;
			}

			return $found ? $type : $traverse($type);
		});

		return $found;
	}

	public function flagReadWithUsedResult(Type $type): Type
	{
		$found = false;
		return TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$found): Type {
			if ($type instanceof TemplateType) {
				$found = true;
			}

			return $found ? $type : $traverse($type);
		});
	}

	/**
	 * @return list<Type>
	 */
	public function append(Type $type): array
	{
		$types = [];
		TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$types): Type {
			$types[] = $type;

			return $traverse($type);
		});

		return $types;
	}

	public function counter(Type $type): int
	{
		$count = 0;
		TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$count): Type {
			$count++;

			return $traverse($type);
		});

		return $count;
	}

	public function nonConstantAssign(Type $type): ?Type
	{
		$last = null;
		TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$last): Type {
			$last = $type;

			return $traverse($type);
		});

		return $last;
	}

	public function keyedCacheRead(Type $type): Type
	{
		$cache = [];
		return TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$cache): Type {
			if (isset($cache['int'])) {
				return $cache['int'];
			}

			$cache['int'] = new IntegerType();

			return $traverse($type);
		});
	}

	public function passedToCall(Type $type): Type
	{
		$types = [];
		return TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$types): Type {
			$types = array_merge($types, [$type]);

			return $traverse($type);
		});
	}

	public function propertyWrite(Type $type): Type
	{
		return TypeTraverser::map($type, function (Type $type, callable $traverse): Type {
			$this->types[] = $type;

			return $traverse($type);
		});
	}

	public function staticVariable(Type $type): Type
	{
		return TypeTraverser::map($type, static function (Type $type, callable $traverse): Type {
			static $seen = 0;

			return $traverse($type);
		});
	}

	public function memoizedPure(Type $type): Type
	{
		return TypeTraverser::mapMemoized($type, static fn (Type $type, callable $traverse): Type => $traverse($type));
	}

	/**
	 * @return list<Type>
	 */
	public function memoizedAppend(Type $type): array
	{
		$types = [];
		TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse) use (&$types): Type {
			$types[] = $type;

			return $traverse($type);
		});

		return $types;
	}

	public function memoizedFlagReadWithUsedResult(Type $type): Type
	{
		$found = false;
		return TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse) use (&$found): Type {
			if ($type instanceof TemplateType) {
				$found = true;
			}

			return $found ? $type : $traverse($type);
		});
	}

	/**
	 * @return array<int, Type>
	 */
	public function memoizedKeyedByObjectId(Type $type): array
	{
		$types = [];
		TypeTraverser::mapMemoized($type, static function (Type $type, callable $traverse) use (&$types): Type {
			$types[spl_object_id($type)] = $type;

			return $traverse($type);
		});

		return $types;
	}

	/**
	 * @return array<int, Type>
	 */
	public function keyedByObjectId(Type $type): array
	{
		$types = [];
		TypeTraverser::map($type, static function (Type $type, callable $traverse) use (&$types): Type {
			$types[spl_object_id($type)] = $type;

			return $traverse($type);
		});

		return $types;
	}

	public function notAClosure(Type $type, callable $cb): Type
	{
		return TypeTraverser::map($type, $cb);
	}

}
